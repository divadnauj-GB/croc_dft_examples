#! /bin/sh -f
#\
mkdir -p logfiles
#\
mkdir -p patterns
#\
exec tessent -shell -log logfiles/$0.log -replace -dofile "$0"
proc cleanup { {pathname_list ""}  } { 
  file delete -force  simulation_outdir  ;
  file delete -force  synthesis_outdir ;
  file delete -force  patterns/* ;
  foreach pathname $pathname_list { file delete -force $pathname  ; } ;
 } 

 cleanup ;

set PDK_ROOT ../../../tech

set_context patterns -scan

set_tsdb_output_directory ../tsdb_outdir

read_cell_library ${PDK_ROOT}/tessent/ihp-sg13g2_stdcell.tcelllib
read_cell_library ${PDK_ROOT}/tessent/ihp-sg13g2_io.tcelllib

#read_cell_library ${PDK_ROOT}/tessent/memories/RM_IHPSG13_1P_256x64_c2_bm_bist.atpglib

## Reads in the scan inserted netlist/design
read_design NV_NVDLA_partition_p  -design_id gate3 -verbose
set_current_design NV_NVDLA_partition_p


report_black_boxes -undefined
add_black_boxes -modules {\
                        RAMDP_16X14_GL_M1_E2 \
                        RAMDP_16X16_GL_M1_E2 \
                        RAMDP_16X66_GL_M1_E2 \
                        RAMDP_8X66_GL_M1_E2 \
                        }
                        
set_system_mode analysis
set_split_capture_cycle on

read_faults -fault_type stuck -mode edt_int_stuck -merge 
read_faults -fault_type stuck -mode ext_multi_stuck -merge 
read_faults -fault_type stuck -mode lbist_sa -merge 
delete_faults -class AU.BB 
report_statistics -detailed


set_fault_type transition

read_faults -fault_type transition -mode ext_multi_transition -merge 
read_faults -fault_type transition -mode edt_int_transition -merge 
read_faults -fault_type transition -mode lbist_tran -merge 

delete_faults -class AU.BB 
report_statistics -detailed

exit